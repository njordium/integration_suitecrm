# js/ is committed on release commits so `git checkout v<tag>` on a
# deploy host (docksrv-int and friends) yields a ready-to-serve app
# without needing node/npm on the host. Same convention as the sibling
# integration_forgejo_gitea app. Regenerate with `npm run build`
# before any commit tagged for release.
.code-workspace
.DS_Store
.idea/
.vscode/
.vscode-upload.json
.*.sw*
node_modules
vendor/
.phpunit.cache/
.phpstan.cache/
composer.lock
# FUSE-mounted filesystems (SSHFS, network drives) create these "ghost"
# files whenever an editor unlinks a still-open file. They're stale
# intermediate snapshots and must never enter git.
.fuse_hidden*
