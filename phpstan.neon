parameters:
  level: 5
  paths:
    - lib
  excludePaths:
    # nextcloud/ocp's abstract App class does not fully resolve under phpstan; scanning Application.php produces spurious errors on parent::__construct.
    - lib/AppInfo/Application.php
  reportUnmatchedIgnoredErrors: false
  ignoreErrors:
    # Legacy properties from the julien-nc port that are set in the constructor
    # but only consumed elsewhere; not worth touching in a CI-focused pass.
    - '#Property .* is never read, only written\.#'
    # OCA\Files\Event\LoadAdditionalScriptsEvent is a Files-app class, not part
    # of the nextcloud/ocp stubs phpstan resolves against. It's dispatched at
    # runtime by the Files app whenever installed; our listener is a no-op if
    # the event's class-name doesn't match, so a missing Files app is safe.
    - '#OCA\\Files\\Event\\LoadAdditionalScriptsEvent#'
  